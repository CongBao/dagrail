{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dagrail.dev/schemas/graph-patch-v1alpha1.schema.json",
  "title": "DAGrail GraphPatch v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "operations"],
  "properties": {
    "apiVersion": {"const": "dagrail.io/v1alpha1"},
    "kind": {"const": "GraphPatch"},
    "operations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/operation"}}
  },
  "$defs": {
    "operation": {
      "oneOf": [
        {"$ref": "#/$defs/nodeMutation"},
        {"$ref": "#/$defs/nodeRemoval"},
        {"$ref": "#/$defs/edgeAddition"},
        {"$ref": "#/$defs/edgeRemoval"},
        {"$ref": "#/$defs/roleMutation"},
        {"$ref": "#/$defs/roleRemoval"},
        {"$ref": "#/$defs/groupMutation"},
        {"$ref": "#/$defs/groupRemoval"},
        {"$ref": "#/$defs/nodeMove"}
      ]
    },
    "nodeMutation": {
      "type": "object", "additionalProperties": false, "required": ["op", "node"],
      "properties": {"op": {"enum": ["addNode", "updateNode"]}, "node": {"$ref": "#/$defs/node"}}
    },
    "nodeRemoval": {
      "type": "object", "additionalProperties": false, "required": ["op", "nodeId"],
      "properties": {"op": {"enum": ["removeNode", "supersedeNode"]}, "nodeId": {"type": "string", "minLength": 1}, "node": {"$ref": "#/$defs/node"}}
    },
    "edgeAddition": {
      "type": "object", "additionalProperties": false, "required": ["op", "edge"],
      "properties": {"op": {"const": "addEdge"}, "edge": {"$ref": "#/$defs/edge"}}
    },
    "edgeRemoval": {
      "type": "object", "additionalProperties": false, "required": ["op", "edgeId"],
      "properties": {"op": {"const": "removeEdge"}, "edgeId": {"type": "string", "minLength": 1}}
    },
    "roleMutation": {
      "type": "object", "additionalProperties": false, "required": ["op", "role"],
      "properties": {"op": {"enum": ["addRole", "updateRole"]}, "role": {"$ref": "#/$defs/role"}}
    },
    "roleRemoval": {
      "type": "object", "additionalProperties": false, "required": ["op", "roleId"],
      "properties": {"op": {"const": "removeRole"}, "roleId": {"type": "string", "minLength": 1}}
    },
    "groupMutation": {
      "type": "object", "additionalProperties": false, "required": ["op", "group"],
      "properties": {"op": {"enum": ["addGroup", "updateGroup"]}, "group": {"$ref": "#/$defs/group"}}
    },
    "groupRemoval": {
      "type": "object", "additionalProperties": false, "required": ["op", "groupId"],
      "properties": {"op": {"const": "removeGroup"}, "groupId": {"type": "string", "minLength": 1, "maxLength": 64}}
    },
    "nodeMove": {
      "type": "object", "additionalProperties": false, "required": ["op", "nodeId"],
      "properties": {"op": {"const": "moveNodeToGroup"}, "nodeId": {"type": "string", "minLength": 1}, "groupId": {"type": "string", "maxLength": 64}}
    },
    "group": {
      "type": "object", "additionalProperties": false, "required": ["id", "title", "kind"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 64}, "title": {"type": "string", "minLength": 1, "maxLength": 256},
        "kind": {"enum": ["work-unit", "milestone", "gate", "external", "governance", "custom"]},
        "parentGroupId": {"type": "string", "minLength": 1, "maxLength": 64}, "summaryNodeId": {"type": "string", "minLength": 1, "maxLength": 256},
        "collapsedByDefault": {"type": "boolean"}
      }
    },
    "role": {
      "type": "object", "additionalProperties": false, "required": ["id", "capabilities"],
      "properties": {"id": {"type": "string", "minLength": 1}, "capabilities": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}}
    },
    "outcome": {
      "type": "object", "additionalProperties": false, "required": ["id", "class"],
      "properties": {"id": {"type": "string", "minLength": 1}, "class": {"enum": ["success", "retryable", "failure", "cancelled"]}}
    },
    "resourceRequest": {
      "type": "object", "additionalProperties": false, "required": ["kind", "quantity"],
      "properties": {"kind": {"type": "string", "minLength": 1}, "quantity": {"type": "integer", "minimum": 1}}
    },
    "externalRef": {
      "type": "object", "required": ["system", "type", "id"],
      "properties": {"system": {"type": "string"}, "type": {"type": "string"}, "id": {"type": "string"}, "url": {"type": "string"}, "revision": {"type": "string"}, "contentDigest": {"type": "string"}}
    },
    "decisionContract": {
      "type": "object", "additionalProperties": false, "required": ["key", "source"],
      "properties": {"key": {"type": "string", "minLength": 1}, "source": {"enum": ["human", "llm", "provider"]}, "providerId": {"type": "string", "minLength": 1}, "policyId": {"type": "string", "minLength": 1}}
    },
    "node": {
      "type": "object", "required": ["id", "kind", "title", "outcomes"],
      "properties": {
        "id": {"type": "string", "minLength": 1}, "kind": {"type": "string", "minLength": 1},
        "role": {"type": "string"}, "title": {"type": "string"}, "objective": {"type": "string"},
        "parent": {"type": "string"}, "groupId": {"type": "string", "minLength": 1, "maxLength": 64}, "supersedes": {"type": "string"}, "inputs": {},
        "outcomes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/outcome"}},
        "retryBudget": {"type": "integer", "minimum": 0}, "resources": {"type": "array", "items": {"$ref": "#/$defs/resourceRequest"}},
        "decision": {"$ref": "#/$defs/decisionContract"}, "externalRefs": {"type": "array", "items": {"$ref": "#/$defs/externalRef"}},
        "metadata": {"type": "object", "additionalProperties": {"type": "string"}}
      }
    },
    "valueMatch": {
      "type": "object", "additionalProperties": false, "required": ["key", "value"],
      "properties": {"key": {"type": "string", "minLength": 1}, "value": {"type": "string", "minLength": 1}}
    },
    "predicate": {
      "type": "object",
      "oneOf": [
        {"required": ["outcome"], "properties": {"outcome": {"type": "string"}}},
        {"required": ["decision"], "properties": {"decision": {"$ref": "#/$defs/valueMatch"}}},
        {"required": ["evidence"], "properties": {"evidence": {"$ref": "#/$defs/valueMatch"}}},
        {"required": ["policy"], "properties": {"policy": {"$ref": "#/$defs/valueMatch"}}},
        {"required": ["all"], "properties": {"all": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/predicate"}}}},
        {"required": ["any"], "properties": {"any": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/predicate"}}}}
      ]
    },
    "edge": {
      "type": "object", "additionalProperties": false, "required": ["id", "from", "to", "when"],
      "properties": {"id": {"type": "string", "minLength": 1}, "from": {"type": "string", "minLength": 1}, "to": {"type": "string", "minLength": 1}, "when": {"$ref": "#/$defs/predicate"}}
    }
  }
}
