{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dagrail.dev/schemas/reuse-decision-v1alpha1.schema.json",
  "title": "DAGrail Reuse Decision v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "id", "packageId", "assessedByAttemptId", "policy", "originalCoreDigest", "currentCore", "currentCoreDigest", "result", "reasons", "createdAt"],
  "properties": {
    "apiVersion": {"const": "dagrail.io/v1alpha1"},
    "kind": {"const": "ReuseDecision"},
    "id": {"type": "string", "pattern": "^reuse_[a-f0-9]{64}$"},
    "packageId": {"type": "string", "pattern": "^epkg_[a-f0-9]{64}$"},
    "assessedByAttemptId": {"type": "string", "format": "uuid"},
    "policy": {
      "type": "object", "additionalProperties": false, "required": ["id", "version", "schemaHash"],
      "properties": {"id": {"type": "string", "minLength": 1, "maxLength": 128}, "version": {"type": "string", "minLength": 1, "maxLength": 128}, "schemaHash": {"$ref": "#/$defs/digest"}}
    },
    "originalCoreDigest": {"$ref": "#/$defs/digest"},
    "currentCore": {
      "type": "object", "additionalProperties": false,
      "required": ["candidateDigest", "prospectiveTreeDigest", "commandGraphDigest", "nodeContractDigest", "protectedInputs"],
      "properties": {
        "candidateDigest": {"$ref": "#/$defs/digest"},
        "prospectiveTreeDigest": {"$ref": "#/$defs/digest"},
        "commandGraphDigest": {"$ref": "#/$defs/digest"},
        "nodeContractDigest": {"$ref": "#/$defs/digest"},
        "protectedInputs": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"type": "object", "additionalProperties": false, "required": ["name", "digest"], "properties": {"name": {"type": "string", "minLength": 1, "maxLength": 128}, "digest": {"$ref": "#/$defs/digest"}}}}
      }
    },
    "currentCoreDigest": {"$ref": "#/$defs/digest"},
    "result": {"enum": ["reuse_execution", "rerun_required"]},
    "reasons": {"type": "array", "minItems": 1, "items": {"enum": ["protected_core_unchanged", "candidate_changed", "prospective_tree_changed", "command_graph_changed", "protected_inputs_changed", "node_contract_changed"]}},
    "createdAt": {"type": "string", "format": "date-time"},
    "sequence": {"type": "integer", "minimum": 1}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}}
}
