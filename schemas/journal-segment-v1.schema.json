{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dagrail.dev/schemas/journal-segment-v1.schema.json",
  "title": "DAGrail Journal Segment v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sequence", "projectId", "previousHash", "command", "events", "committedAt", "segmentHash"],
  "properties": {
    "schemaVersion": {"const": 1},
    "sequence": {"type": "integer", "minimum": 1},
    "projectId": {"type": "string", "format": "uuid"},
    "previousHash": {"type": "string", "pattern": "^$|^[a-f0-9]{64}$"},
    "command": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "idempotencyKey"],
      "properties": {"id": {"type": "string", "format": "uuid"}, "kind": {"type": "string"}, "actorRole": {"type": "string"}, "idempotencyKey": {"type": "string"}}
    },
    "events": {
      "type": "array", "minItems": 1,
      "items": {"type": "object", "additionalProperties": false, "required": ["type", "payload"], "properties": {"type": {"type": "string"}, "payload": {"type": "object"}}}
    },
    "committedAt": {"type": "string", "format": "date-time"},
    "segmentHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
