{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dagrail.dev/schemas/command-catalog-v1alpha1.schema.json",
  "title": "DAGrail Command Catalog v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "version", "commands", "errors"],
  "properties": {
    "apiVersion": {"const": "dagrail.io/command-catalog/v1alpha1"},
    "kind": {"const": "CommandCatalog"},
    "version": {"type": "string", "minLength": 1, "maxLength": 128},
    "commands": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "summary", "effect", "project", "output", "subcommands"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
          "summary": {"type": "string", "minLength": 1, "maxLength": 256},
          "effect": {"enum": ["read", "write", "mixed", "serve"]},
          "project": {"enum": ["none", "optional", "required"]},
          "output": {"enum": ["json", "text", "transport"]},
          "subcommands": {
            "type": "array",
            "maxItems": 64,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"}
          }
        }
      }
    },
    "errors": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiVersion", "optIn", "maxBytes", "exitCodes"],
      "properties": {
        "apiVersion": {"const": "dagrail.io/cli-error/v1alpha1"},
        "optIn": {"type": "string", "minLength": 1, "maxLength": 256},
        "maxBytes": {"type": "integer", "minimum": 512, "maximum": 16384},
        "exitCodes": {
          "type": "array",
          "minItems": 4,
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "exitCode", "retryable"],
            "properties": {
              "code": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"},
              "exitCode": {"type": "integer", "minimum": 1, "maximum": 255},
              "retryable": {"type": "boolean"}
            }
          }
        }
      }
    }
  }
}
