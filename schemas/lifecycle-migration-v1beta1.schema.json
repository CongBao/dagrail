{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dagrail.dev/schemas/lifecycle-migration-v1beta1.schema.json",
  "title": "DAGrail Lifecycle Migration v1beta1",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "projectId", "graphRevision", "expectedJournalHead", "source", "recordsDigest", "records"],
  "properties": {
    "apiVersion": {"const": "dagrail.io/lifecycle-migration/v1beta1"},
    "kind": {"const": "LifecycleMigration"},
    "projectId": {"type": "string", "format": "uuid"},
    "graphRevision": {"$ref": "#/$defs/hash"},
    "expectedJournalHead": {"$ref": "#/$defs/hash"},
    "source": {"$ref": "#/$defs/source"},
    "recordsDigest": {"$ref": "#/$defs/digest"},
    "records": {"type": "array", "minItems": 1, "maxItems": 10000, "items": {"$ref": "#/$defs/record"}}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "timestamp": {"type": "string", "format": "date-time"},
    "stringMap": {"type": "object", "additionalProperties": {"type": "string"}},
    "facts": {"type": "object", "additionalProperties": false, "properties": {"decision": {"$ref": "#/$defs/stringMap"}, "evidence": {"$ref": "#/$defs/stringMap"}, "policy": {"$ref": "#/$defs/stringMap"}}},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["system", "project", "authorityHash", "headSequence", "headEventId", "headEventHash"],
      "properties": {"system": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9][A-Za-z0-9._@-]*$", "not": {"pattern": "\\.\\."}}, "project": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[A-Za-z0-9][A-Za-z0-9._@-]*$", "not": {"pattern": "\\.\\."}}, "authorityHash": {"allOf": [{"$ref": "#/$defs/digest"}], "description": "SHA-256 over dagrail-lifecycle-source-authority-v2 NUL plus RFC 8785 of the complete manifest with this field set to the empty string."}, "headSequence": {"type": "integer", "minimum": 1, "maximum": 10000}, "headEventId": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[A-Za-z0-9][A-Za-z0-9._@-]*$", "not": {"pattern": "\\.\\."}}, "headEventHash": {"$ref": "#/$defs/digest"}}
    },
    "evidenceRef": {"type": "object", "additionalProperties": false, "required": ["digest", "type", "size"], "properties": {"digest": {"$ref": "#/$defs/digest"}, "type": {"type": "string", "minLength": 1}, "size": {"type": "integer", "minimum": 0}, "uri": {"type": "string", "maxLength": 2048}}},
    "roleLease": {"type": "object", "additionalProperties": false, "required": ["roleId", "harness", "sessionId", "boundAt", "expiresAt", "active"], "properties": {"roleId": {"type": "string", "minLength": 1}, "harness": {"type": "string", "minLength": 1}, "sessionId": {"type": "string", "minLength": 1}, "boundAt": {"$ref": "#/$defs/timestamp"}, "expiresAt": {"$ref": "#/$defs/timestamp"}, "active": {"const": true}}},
    "roleRelease": {"type": "object", "additionalProperties": false, "required": ["roleId", "releasedAt"], "properties": {"roleId": {"type": "string", "minLength": 1}, "releasedAt": {"$ref": "#/$defs/timestamp"}}},
    "attempt": {"type": "object", "additionalProperties": false, "required": ["id", "nodeId", "roleId", "number", "status", "startedAt", "updatedAt"], "properties": {"id": {"type": "string", "minLength": 1}, "nodeId": {"type": "string", "minLength": 1}, "roleId": {"type": "string", "minLength": 1}, "number": {"type": "integer", "minimum": 1}, "status": {"const": "leased"}, "startedAt": {"$ref": "#/$defs/timestamp"}, "updatedAt": {"$ref": "#/$defs/timestamp"}}},
    "attemptStatus": {"type": "object", "additionalProperties": false, "required": ["attemptId", "status", "updatedAt"], "properties": {"attemptId": {"type": "string", "minLength": 1}, "status": {"enum": ["leased", "running", "waiting", "submitted"]}, "updatedAt": {"$ref": "#/$defs/timestamp"}}},
    "checkpoint": {"type": "object", "additionalProperties": false, "required": ["id", "attemptId", "summary", "createdAt"], "properties": {"id": {"type": "string", "minLength": 1}, "attemptId": {"type": "string", "minLength": 1}, "summary": {"type": "string", "minLength": 1, "maxLength": 2048}, "evidenceRefs": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/evidenceRef"}}, "createdAt": {"$ref": "#/$defs/timestamp"}}},
    "attemptFinished": {"type": "object", "additionalProperties": false, "required": ["attemptId", "outcome", "outcomeClass", "facts", "updatedAt"], "properties": {"attemptId": {"type": "string", "minLength": 1}, "outcome": {"type": "string", "minLength": 1}, "outcomeClass": {"enum": ["success", "retryable", "failure", "cancelled"]}, "facts": {"$ref": "#/$defs/facts"}, "updatedAt": {"$ref": "#/$defs/timestamp"}}},
    "resourceLease": {"type": "object", "additionalProperties": false, "required": ["id", "kind", "quantity", "nodeId", "attemptId", "roleId", "status", "closureStatus", "leasedAt"], "properties": {"id": {"type": "string", "minLength": 1}, "kind": {"type": "string", "minLength": 1}, "quantity": {"type": "integer", "minimum": 1}, "nodeId": {"type": "string", "minLength": 1}, "attemptId": {"type": "string", "minLength": 1}, "roleId": {"type": "string", "minLength": 1}, "status": {"const": "active"}, "closureStatus": {"const": "pending"}, "leasedAt": {"$ref": "#/$defs/timestamp"}}},
    "resourceObserved": {"type": "object", "additionalProperties": false, "required": ["resourceId", "status", "receipt", "updatedAt"], "properties": {"resourceId": {"type": "string", "minLength": 1}, "status": {"enum": ["confirmed", "failed", "unknown"]}, "receipt": {"not": {"type": "null"}}, "updatedAt": {"$ref": "#/$defs/timestamp"}}},
    "resourceReleased": {"type": "object", "additionalProperties": false, "required": ["resourceId", "releasedAt"], "properties": {"resourceId": {"type": "string", "minLength": 1}, "releasedAt": {"$ref": "#/$defs/timestamp"}}},
    "action": {"type": "object", "additionalProperties": false, "required": ["id", "kind", "nodeId", "status", "input"], "properties": {"id": {"type": "string", "minLength": 1}, "kind": {"enum": ["role.renew", "node.start", "attempt.checkpoint", "attempt.wait", "attempt.resume", "attempt.submit", "task.complete", "review.resolve", "decision.record", "gate.evaluate", "attempt.finish", "effect.prepare", "effect.complete", "resource.close", "resource.reconcile", "evidence.publish", "evidence.assess-reuse"]}, "nodeId": {"type": "string", "minLength": 1}, "attemptId": {"type": "string", "minLength": 1}, "status": {"enum": ["prepared", "confirmed", "failed", "unknown"]}, "input": {}, "sequence": {"type": "integer", "minimum": 0}}, "allOf": [{"if": {"properties": {"kind": {"not": {"const": "role.renew"}}}}, "then": {"required": ["attemptId"]}}]},
    "preparedEffect": {"type": "object", "additionalProperties": false, "required": ["adapterId", "binding"], "properties": {"adapterId": {"type": "string", "minLength": 1}, "binding": {}}},
    "effectReceipt": {"type": "object", "additionalProperties": false, "required": ["status"], "properties": {"status": {"enum": ["confirmed", "failed", "unknown", "reconciling"]}, "externalId": {"type": "string"}, "transportAccepted": {"type": "boolean"}, "recipientVisible": {"type": "boolean"}, "transportStatus": {"enum": ["not-attempted", "accepted", "rejected", "unknown"]}, "sessionStatus": {"enum": ["not-created", "created", "unknown"]}, "deliveryStatus": {"enum": ["pending", "visible", "failed", "unknown"]}, "acceptanceStatus": {"enum": ["pending", "accepted", "returned", "unknown"]}, "completionStatus": {"enum": ["pending", "completed", "failed", "unknown"]}, "detail": {}}},
    "effect": {"type": "object", "additionalProperties": false, "required": ["id", "nodeId", "attemptId", "adapterId", "ownerRole", "status", "request", "prepared", "idempotencyKey", "preparedAt", "updatedAt"], "dependentRequired": {"adapterVersion": ["adapterSchemaHash"], "adapterSchemaHash": ["adapterVersion"]}, "properties": {"id": {"type": "string", "minLength": 1}, "nodeId": {"type": "string", "minLength": 1}, "attemptId": {"type": "string", "minLength": 1}, "adapterId": {"type": "string", "minLength": 1}, "adapterVersion": {"type": "string", "minLength": 1}, "adapterSchemaHash": {"type": "string", "minLength": 1}, "ownerRole": {"type": "string", "minLength": 1}, "status": {"const": "prepared"}, "request": {"not": {"type": "null"}}, "prepared": {"$ref": "#/$defs/preparedEffect"}, "idempotencyKey": {"type": "string", "minLength": 1}, "preparedAt": {"$ref": "#/$defs/timestamp"}, "updatedAt": {"$ref": "#/$defs/timestamp"}, "sequence": {"type": "integer", "minimum": 0}}},
    "effectDispatched": {"type": "object", "additionalProperties": false, "required": ["actionId", "dispatchedAt"], "properties": {"actionId": {"type": "string", "minLength": 1}, "dispatchedAt": {"$ref": "#/$defs/timestamp"}}},
    "effectReconciling": {"type": "object", "additionalProperties": false, "required": ["actionId", "reconcilingAt"], "properties": {"actionId": {"type": "string", "minLength": 1}, "reconcilingAt": {"$ref": "#/$defs/timestamp"}}},
    "effectObserved": {"type": "object", "additionalProperties": false, "required": ["actionId", "status", "receipt", "updatedAt"], "properties": {"actionId": {"type": "string", "minLength": 1}, "status": {"enum": ["confirmed", "failed", "unknown", "reconciling"]}, "receipt": {"$ref": "#/$defs/effectReceipt"}, "updatedAt": {"$ref": "#/$defs/timestamp"}}},
    "incidentControl": {"type": "object", "additionalProperties": false, "required": ["authority", "actorRole", "originalOwnerRole", "disposition", "resolution", "note", "appliedAt"], "properties": {"authority": {"const": "incident.control"}, "actorRole": {"type": "string", "minLength": 1}, "originalOwnerRole": {"type": "string", "minLength": 1}, "disposition": {"enum": ["rollback", "lkg", "quarantine", "off-critical-path"]}, "resolution": {"type": "string", "minLength": 1, "maxLength": 1024}, "note": {"type": "string", "minLength": 1, "maxLength": 1024}, "appliedAt": {"$ref": "#/$defs/timestamp"}}},
    "incident": {"type": "object", "additionalProperties": false, "required": ["id", "sourceType", "sourceId", "status", "classification", "attemptBudget", "attempts", "openedAt", "updatedAt"], "properties": {"id": {"type": "string", "minLength": 1}, "sourceType": {"enum": ["attempt", "effect", "resource"]}, "sourceId": {"type": "string", "minLength": 1}, "nodeId": {"type": "string"}, "ownerRole": {"type": "string"}, "status": {"enum": ["open", "circuit-open", "resolved"]}, "classification": {"enum": ["work-product", "policy", "fixture", "infrastructure", "evidence", "external-effect", "unknown"]}, "deadline": {"$ref": "#/$defs/timestamp"}, "attemptBudget": {"type": "integer", "minimum": 1}, "attempts": {"type": "integer", "minimum": 0}, "noProgressAttempts": {"type": "integer", "minimum": 0}, "progressMetric": {"type": "string"}, "lastProgress": {"type": "string"}, "lastProgressAt": {"$ref": "#/$defs/timestamp"}, "circuitReason": {"type": "string"}, "resolution": {"type": "string"}, "disposition": {"enum": ["retry", "rollback", "lkg", "quarantine", "off-critical-path", "escalate"]}, "dispositionBy": {"type": "string"}, "dispositionAt": {"$ref": "#/$defs/timestamp"}, "dependencyCut": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "remedyNodeId": {"type": "string"}, "supersededAt": {"$ref": "#/$defs/timestamp"}, "control": {"$ref": "#/$defs/incidentControl"}, "openedAt": {"$ref": "#/$defs/timestamp"}, "updatedAt": {"$ref": "#/$defs/timestamp"}}},
    "incidentResolved": {"type": "object", "additionalProperties": false, "required": ["incidentId", "resolvedAt"], "properties": {"incidentId": {"type": "string", "minLength": 1}, "resolvedAt": {"$ref": "#/$defs/timestamp"}}},
    "artifactProvenance": {"type": "object", "additionalProperties": false, "required": ["producer"], "properties": {"producer": {"type": "string", "minLength": 1, "maxLength": 256}, "revision": {"type": "string", "maxLength": 256}, "invocationDigest": {"$ref": "#/$defs/digest"}}},
    "artifact": {"type": "object", "additionalProperties": false, "required": ["digest", "type", "size", "provenance"], "properties": {"digest": {"$ref": "#/$defs/digest"}, "type": {"type": "string", "minLength": 1, "maxLength": 128}, "size": {"type": "integer", "minimum": 0}, "uri": {"type": "string", "maxLength": 2048}, "provenance": {"$ref": "#/$defs/artifactProvenance"}}},
    "protectedInput": {"type": "object", "additionalProperties": false, "required": ["name", "digest"], "properties": {"name": {"type": "string", "minLength": 1, "maxLength": 128}, "digest": {"$ref": "#/$defs/digest"}}},
    "observations": {"type": "object", "additionalProperties": false, "required": ["exact", "clean", "depthComplete", "sourceUnmodified", "resourcesClosed"], "properties": {"exact": {"type": "boolean"}, "clean": {"type": "boolean"}, "depthComplete": {"type": "boolean"}, "sourceUnmodified": {"type": "boolean"}, "resourcesClosed": {"type": "boolean"}}},
    "executionPackage": {"type": "object", "additionalProperties": false, "required": ["apiVersion", "kind", "id", "projectId", "graphRevision", "nodeId", "attemptId", "nodeContractDigest", "candidate", "prospectiveTree", "commandGraphDigest", "protectedInputs", "observations", "artifacts", "coreDigest", "createdAt"], "properties": {"apiVersion": {"const": "dagrail.io/v1alpha1"}, "kind": {"const": "ExecutionPackage"}, "id": {"type": "string", "pattern": "^epkg_[0-9a-f]{64}$"}, "projectId": {"type": "string", "format": "uuid"}, "graphRevision": {"$ref": "#/$defs/hash"}, "nodeId": {"type": "string", "minLength": 1}, "attemptId": {"type": "string", "minLength": 1}, "nodeContractDigest": {"$ref": "#/$defs/digest"}, "candidate": {"$ref": "#/$defs/artifact"}, "prospectiveTree": {"$ref": "#/$defs/artifact"}, "commandGraphDigest": {"$ref": "#/$defs/digest"}, "protectedInputs": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"$ref": "#/$defs/protectedInput"}}, "observations": {"$ref": "#/$defs/observations"}, "artifacts": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/artifact"}}, "coreDigest": {"$ref": "#/$defs/digest"}, "createdAt": {"$ref": "#/$defs/timestamp"}, "sequence": {"type": "integer", "minimum": 0}}},
    "policyBinding": {"type": "object", "additionalProperties": false, "required": ["id", "version", "schemaHash"], "properties": {"id": {"type": "string", "minLength": 1, "maxLength": 128}, "version": {"type": "string", "minLength": 1, "maxLength": 128}, "schemaHash": {"$ref": "#/$defs/digest"}}},
    "executionCore": {"type": "object", "additionalProperties": false, "required": ["candidateDigest", "prospectiveTreeDigest", "commandGraphDigest", "nodeContractDigest", "protectedInputs"], "properties": {"candidateDigest": {"$ref": "#/$defs/digest"}, "prospectiveTreeDigest": {"$ref": "#/$defs/digest"}, "commandGraphDigest": {"$ref": "#/$defs/digest"}, "nodeContractDigest": {"$ref": "#/$defs/digest"}, "protectedInputs": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"$ref": "#/$defs/protectedInput"}}}},
    "reuseDecision": {"type": "object", "additionalProperties": false, "required": ["apiVersion", "kind", "id", "packageId", "assessedByAttemptId", "policy", "originalCoreDigest", "currentCore", "currentCoreDigest", "result", "reasons", "createdAt"], "properties": {"apiVersion": {"const": "dagrail.io/v1alpha1"}, "kind": {"const": "ReuseDecision"}, "id": {"type": "string", "pattern": "^reuse_[0-9a-f]{64}$"}, "packageId": {"type": "string", "pattern": "^epkg_[0-9a-f]{64}$"}, "assessedByAttemptId": {"type": "string", "minLength": 1}, "policy": {"$ref": "#/$defs/policyBinding"}, "originalCoreDigest": {"$ref": "#/$defs/digest"}, "currentCore": {"$ref": "#/$defs/executionCore"}, "currentCoreDigest": {"$ref": "#/$defs/digest"}, "result": {"enum": ["reuse_execution", "rerun_required"]}, "reasons": {"type": "array", "items": {"type": "string"}}, "createdAt": {"$ref": "#/$defs/timestamp"}, "sequence": {"type": "integer", "minimum": 0}}},
    "decisionProvider": {"type": "object", "additionalProperties": false, "required": ["id", "version", "schemaHash"], "properties": {"id": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}, "schemaHash": {"$ref": "#/$defs/digest"}}},
    "decisionRecord": {"type": "object", "additionalProperties": false, "required": ["id", "projectId", "graphRevision", "nodeId", "attemptId", "roleId", "key", "source", "outcome", "inputDigest", "createdAt"], "properties": {"id": {"type": "string", "pattern": "^decision_[0-9a-f]{64}$"}, "projectId": {"type": "string", "minLength": 1}, "graphRevision": {"$ref": "#/$defs/hash"}, "nodeId": {"type": "string", "minLength": 1}, "attemptId": {"type": "string", "minLength": 1}, "roleId": {"type": "string", "minLength": 1}, "key": {"type": "string", "minLength": 1}, "source": {"enum": ["human", "llm", "provider"]}, "outcome": {"type": "string", "minLength": 1}, "facts": {"$ref": "#/$defs/facts"}, "evidenceRefs": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/evidenceRef"}}, "inputDigest": {"$ref": "#/$defs/digest"}, "provider": {"$ref": "#/$defs/decisionProvider"}, "createdAt": {"$ref": "#/$defs/timestamp"}, "sequence": {"type": "integer", "minimum": 0}}},
    "nativeEvent": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["type", "payload"], "properties": {"type": {"const": "role.bound"}, "payload": {"$ref": "#/$defs/roleLease"}}},
        {"type": "object", "additionalProperties": false, "required": ["type", "payload"], "properties": {"type": {"const": "role.released"}, "payload": {"$ref": "#/$defs/roleRelease"}}},
        {"type": "object", "additionalProperties": false, "required": ["type", "payload"], "properties": {"type": {"enum": ["attempt.started", "attempt.leased"]}, "payload": {"$ref": "#/$defs/attempt"}}},
        {"type": "object", "additionalProperties": false, "required": ["type", "payload"], "properties": {"type": {"const": "attempt.status-changed"}, "payload": {"$ref": "#/$defs/attemptStatus"}}},
        {"type": "object", "additionalProperties": false, "required": ["type", "payload"], "properties": {"type": {"const": "attempt.checkpointed"}, "payload": {"$ref": "#/$defs/checkpoint"}}},
        {"type": "object", "additionalProperties": false, "required": ["type", "payload"], "properties": {"type": {"const": "attempt.finished"}, "payload": {"$ref": "#/$defs/attemptFinished"}}},
        {"type": "object", "additionalProperties": false, "required": ["type", "payload"], "properties": {"type": {"const": "evidence.package-published"}, "payload": {"$ref": "#/$defs/executionPackage"}}},
        {"type": "object", "additionalProperties": false, "required": ["type", "payload"], "properties": {"type": {"const": "evidence.reuse-assessed"}, "payload": {"$ref": "#/$defs/reuseDecision"}}},
        {"type": "object", "additionalProperties": false, "required": ["type", "payload"], "properties": {"type": {"const": "decision.recorded"}, "payload": {"$ref": "#/$defs/decisionRecord"}}},
        {"type": "object", "additionalProperties": false, "required": ["type", "payload"], "properties": {"type": {"const": "resource.leased"}, "payload": {"$ref": "#/$defs/resourceLease"}}},
        {"type": "object", "additionalProperties": false, "required": ["type", "payload"], "properties": {"type": {"const": "resource.closure-observed"}, "payload": {"$ref": "#/$defs/resourceObserved"}}},
        {"type": "object", "additionalProperties": false, "required": ["type", "payload"], "properties": {"type": {"const": "resource.released"}, "payload": {"$ref": "#/$defs/resourceReleased"}}},
        {"type": "object", "additionalProperties": false, "required": ["type", "payload"], "properties": {"type": {"const": "action.applied"}, "payload": {"$ref": "#/$defs/action"}}},
        {"type": "object", "additionalProperties": false, "required": ["type", "payload"], "properties": {"type": {"const": "effect.prepared"}, "payload": {"$ref": "#/$defs/effect"}}},
        {"type": "object", "additionalProperties": false, "required": ["type", "payload"], "properties": {"type": {"const": "effect.dispatched"}, "payload": {"$ref": "#/$defs/effectDispatched"}}},
        {"type": "object", "additionalProperties": false, "required": ["type", "payload"], "properties": {"type": {"const": "effect.reconciling"}, "payload": {"$ref": "#/$defs/effectReconciling"}}},
        {"type": "object", "additionalProperties": false, "required": ["type", "payload"], "properties": {"type": {"const": "effect.observed"}, "payload": {"$ref": "#/$defs/effectObserved"}}},
        {"type": "object", "additionalProperties": false, "required": ["type", "payload"], "properties": {"type": {"enum": ["incident.opened", "incident.updated"]}, "payload": {"$ref": "#/$defs/incident"}}},
        {"type": "object", "additionalProperties": false, "required": ["type", "payload"], "properties": {"type": {"const": "incident.resolved"}, "payload": {"$ref": "#/$defs/incidentResolved"}}}
      ]
    },
    "command": {"type": "object", "additionalProperties": false, "required": ["commandIndex", "events"], "properties": {"commandIndex": {"type": "integer", "minimum": 1, "maximum": 128}, "events": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"$ref": "#/$defs/nativeEvent"}}}},
    "record": {
      "type": "object", "additionalProperties": false,
      "required": ["sourceSequence", "sourceEventId", "sourceEventHash", "occurredAt", "commands"],
      "properties": {"sourceSequence": {"type": "integer", "minimum": 1, "maximum": 10000}, "sourceEventId": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[A-Za-z0-9][A-Za-z0-9._@-]*$", "not": {"pattern": "\\.\\."}}, "sourceEventHash": {"allOf": [{"$ref": "#/$defs/digest"}], "description": "SHA-256 over dagrail-lifecycle-source-event-v2 NUL plus RFC 8785 of sourceSequence, sourceEventId, optional previousSourceEventHash, occurredAt, and commands."}, "previousSourceEventHash": {"$ref": "#/$defs/digest"}, "occurredAt": {"$ref": "#/$defs/timestamp"}, "commands": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"$ref": "#/$defs/command"}}}
    }
  }
}
