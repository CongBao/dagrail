{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/CongBao/dagrail/schemas/recovery-rehearsal-v1alpha1.schema.json",
  "title": "DAGrail Recovery Rehearsal v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "ready",
    "projectRef",
    "buildVersion",
    "snapshot",
    "compatibility",
    "sourceProjection",
    "rebuiltProjection",
    "projectionEquivalent",
    "checks"
  ],
  "properties": {
    "apiVersion": { "const": "dagrail.io/recovery-rehearsal/v1alpha1" },
    "kind": { "const": "RecoveryRehearsal" },
    "ready": { "type": "boolean" },
    "projectRef": { "$ref": "#/$defs/digest" },
    "buildVersion": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._+:-]+$" },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["headSequence", "segments", "stateDigest"],
      "properties": {
        "headSequence": { "type": "integer", "minimum": 0 },
        "headHash": { "$ref": "#/$defs/hash" },
        "graphRevision": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "segments": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "stateDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "compatibility": { "$ref": "#/$defs/compatibility" },
    "sourceProjection": { "$ref": "#/$defs/projection" },
    "rebuiltProjection": { "$ref": "#/$defs/projection" },
    "projectionEquivalent": { "type": "boolean" },
    "checks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status", "code"],
        "properties": {
          "name": {
            "enum": [
              "journal-snapshot",
              "schema-compatibility",
              "source-projection",
              "journal-restore",
              "state-replay",
              "projection-rebuild",
              "projection-equivalence"
            ]
          },
          "status": { "enum": ["pass", "fail"] },
          "code": {
            "enum": [
              "verified_immutable_prefix",
              "unreadable_schema",
              "all_events_upcastable",
              "integrity_failed",
              "fingerprint_failed",
              "future_schema_unsupported",
              "snapshot_head_mismatch",
              "snapshot_bound",
              "restore_rejected",
              "restored_prefix_mismatch",
              "exact_prefix_restored",
              "reducer_replay_failed",
              "state_digest_mismatch",
              "state_digest_reproduced",
              "rebuild_failed",
              "rebuilt_head_mismatch",
              "disposable_rebuild_verified",
              "logical_fingerprint_mismatch",
              "logical_fingerprints_match"
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "counts": {
      "type": "object",
      "propertyNames": { "pattern": "^[0-9]+$" },
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "compatible",
        "segmentCount",
        "eventCount",
        "legacySegmentCount",
        "upcastedEventCount",
        "readableSegmentSchemas",
        "currentWriteSegmentSchema",
        "currentWriteEventSchema",
        "segmentSchemas",
        "eventSchemas"
      ],
      "properties": {
        "compatible": { "const": true },
        "segmentCount": { "type": "integer", "minimum": 0 },
        "eventCount": { "type": "integer", "minimum": 0 },
        "legacySegmentCount": { "type": "integer", "minimum": 0 },
        "upcastedEventCount": { "type": "integer", "minimum": 0 },
        "readableSegmentSchemas": { "type": "array", "items": { "type": "integer", "minimum": 1 }, "minItems": 1, "uniqueItems": true },
        "currentWriteSegmentSchema": { "type": "integer", "minimum": 1 },
        "currentWriteEventSchema": { "type": "integer", "minimum": 1 },
        "segmentSchemas": { "$ref": "#/$defs/counts" },
        "eventSchemas": { "$ref": "#/$defs/counts" }
      }
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["integrity", "schema", "headSequence"],
      "properties": {
        "integrity": { "type": "boolean" },
        "schema": { "type": "integer", "minimum": 0 },
        "headSequence": { "type": "integer", "minimum": 0 },
        "headHash": { "$ref": "#/$defs/hash" },
        "fingerprint": { "$ref": "#/$defs/digest" },
        "rows": {
          "type": "object",
          "propertyNames": { "pattern": "^[a-z_]+$" },
          "additionalProperties": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}
