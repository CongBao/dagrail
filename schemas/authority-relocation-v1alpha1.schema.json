{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dagrail.dev/schemas/authority-relocation-v1alpha1.schema.json",
  "title": "DAGrail Authority Relocation Receipt v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "sourceProjectId", "previousLocatorProjectId", "sourceHead", "recoveryHead", "recoveryBackupDigest", "targetRootDigest", "destinationRuntimeDigest", "replacementProjectId", "relocatedAt", "reason", "idempotencyKey", "receiptDigest"],
  "properties": {
    "apiVersion": {"const": "dagrail.io/authority-relocation/v1alpha1"},
    "kind": {"const": "AuthorityRelocationReceipt"},
    "sourceProjectId": {"type": "string", "format": "uuid"},
    "previousLocatorProjectId": {"type": "string", "format": "uuid"},
    "sourceHead": {"$ref": "#/$defs/hash"},
    "recoveryHead": {"$ref": "#/$defs/hash"},
    "recoveryBackupDigest": {"$ref": "#/$defs/digest"},
    "targetRootDigest": {"$ref": "#/$defs/digest"},
    "destinationRuntimeDigest": {"$ref": "#/$defs/digest"},
    "replacementProjectId": {"type": "string", "format": "uuid"},
    "relocatedAt": {"type": "string", "format": "date-time"},
    "reason": {"type": "string", "minLength": 1, "maxLength": 1024},
    "idempotencyKey": {"type": "string", "minLength": 1, "maxLength": 256},
    "receiptDigest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
