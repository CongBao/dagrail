{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dagrail.dev/schemas/lifecycle-projection-v1alpha1.schema.json",
  "title": "DAGrail Lifecycle Projection v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "projectId", "graphRevision", "journalHead", "headSequence", "migrations", "nodes", "attempts", "leases", "checkpoints", "decisions", "evidencePackages", "reuseDecisions", "actions", "effects", "resources", "incidents", "frontier", "projectionDigest"],
  "properties": {
    "apiVersion": {"const": "dagrail.io/lifecycle-projection/v1alpha1"},
    "kind": {"const": "LifecycleProjection"},
    "projectId": {"type": "string", "format": "uuid"},
    "graphRevision": {"$ref": "#/$defs/hash"},
    "journalHead": {"$ref": "#/$defs/hash"},
    "headSequence": {"type": "integer", "minimum": 1},
    "migrations": {"type": "array", "items": {"$ref": "#/$defs/migration"}},
    "nodes": {"type": "array", "items": {"$ref": "#/$defs/node"}},
    "attempts": {"type": "array", "items": {"$ref": "#/$defs/attempt"}},
    "leases": {"type": "array", "items": {"$ref": "#/$defs/lease"}},
    "checkpoints": {"type": "array", "items": {"$ref": "#/$defs/checkpoint"}},
    "decisions": {"type": "array", "items": {"$ref": "#/$defs/decision"}},
    "evidencePackages": {"type": "array", "items": {"$ref": "#/$defs/executionPackage"}},
    "reuseDecisions": {"type": "array", "items": {"$ref": "#/$defs/reuseDecision"}},
    "actions": {"type": "array", "items": {"$ref": "#/$defs/action"}},
    "effects": {"type": "array", "items": {"$ref": "#/$defs/effect"}},
    "resources": {"type": "array", "items": {"$ref": "#/$defs/resource"}},
    "incidents": {"type": "array", "items": {"$ref": "#/$defs/incident"}},
    "frontier": {"$ref": "#/$defs/frontier"},
    "projectionDigest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "timestamp": {"type": "string", "format": "date-time"},
    "stringMap": {"type": "object", "additionalProperties": {"type": "string"}},
    "facts": {"type": "object", "additionalProperties": false, "properties": {"decision": {"$ref": "#/$defs/stringMap"}, "evidence": {"$ref": "#/$defs/stringMap"}, "policy": {"$ref": "#/$defs/stringMap"}}},
    "evidenceRef": {
      "type": "object", "additionalProperties": false, "required": ["digest", "type", "size"],
      "properties": {"digest": {"$ref": "#/$defs/digest"}, "type": {"type": "string", "minLength": 1}, "size": {"type": "integer", "minimum": 0}}
    },
    "migration": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "sourceSystem", "sourceProject", "sourceAuthorityHash", "sourceHeadSequence", "sourceHeadEventId", "sourceHeadEventHash", "recordsDigest", "recordCount", "nativeEventCount", "graphRevision", "targetSequence", "importedAt"],
      "properties": {"id": {"type": "string", "pattern": "^migration_[0-9a-f]{64}$"}, "sourceSystem": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9][A-Za-z0-9._@-]*$", "not": {"pattern": "\\.\\."}}, "sourceProject": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[A-Za-z0-9][A-Za-z0-9._@-]*$", "not": {"pattern": "\\.\\."}}, "sourceAuthorityHash": {"$ref": "#/$defs/digest"}, "sourceHeadSequence": {"type": "integer", "minimum": 1}, "sourceHeadEventId": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[A-Za-z0-9][A-Za-z0-9._@-]*$", "not": {"pattern": "\\.\\."}}, "sourceHeadEventHash": {"$ref": "#/$defs/digest"}, "recordsDigest": {"$ref": "#/$defs/digest"}, "recordCount": {"type": "integer", "minimum": 1}, "nativeEventCount": {"type": "integer", "minimum": 1}, "graphRevision": {"$ref": "#/$defs/hash"}, "targetSequence": {"type": "integer", "minimum": 1}, "importedAt": {"$ref": "#/$defs/timestamp"}}
    },
    "node": {
      "type": "object", "additionalProperties": false, "required": ["id", "status"],
      "properties": {"id": {"type": "string", "minLength": 1}, "status": {"enum": ["planned", "active", "terminal", "superseded", "skipped"]}, "outcome": {"type": "string"}, "outcomeClass": {"enum": ["success", "retryable", "failure", "cancelled"]}, "facts": {"$ref": "#/$defs/facts"}}
    },
    "attempt": {
      "type": "object", "additionalProperties": false, "required": ["id", "nodeId", "roleId", "number", "status", "startedAt", "updatedAt"],
      "properties": {"id": {"type": "string", "minLength": 1}, "nodeId": {"type": "string", "minLength": 1}, "roleId": {"type": "string", "minLength": 1}, "number": {"type": "integer", "minimum": 1}, "status": {"enum": ["leased", "running", "waiting", "submitted", "terminal"]}, "outcome": {"type": "string"}, "checkpointId": {"type": "string"}, "startedAt": {"$ref": "#/$defs/timestamp"}, "updatedAt": {"$ref": "#/$defs/timestamp"}}
    },
    "lease": {
      "type": "object", "additionalProperties": false, "required": ["roleId", "harness", "sessionId", "boundAt", "expiresAt", "active"],
      "properties": {"roleId": {"type": "string", "minLength": 1}, "harness": {"type": "string", "minLength": 1}, "sessionId": {"type": "string", "minLength": 1}, "boundAt": {"$ref": "#/$defs/timestamp"}, "expiresAt": {"$ref": "#/$defs/timestamp"}, "active": {"type": "boolean"}}
    },
    "checkpoint": {
      "type": "object", "additionalProperties": false, "required": ["id", "attemptId", "summary", "createdAt"],
      "properties": {"id": {"type": "string", "minLength": 1}, "attemptId": {"type": "string", "minLength": 1}, "summary": {"type": "string", "minLength": 1, "maxLength": 2048}, "evidenceRefs": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/evidenceRef"}}, "createdAt": {"$ref": "#/$defs/timestamp"}}
    },
    "provider": {"type": "object", "additionalProperties": false, "required": ["id", "version", "schemaHash"], "properties": {"id": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}, "schemaHash": {"$ref": "#/$defs/digest"}}},
    "decision": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "projectId", "graphRevision", "nodeId", "attemptId", "roleId", "key", "source", "outcome", "inputDigest", "createdAt"],
      "properties": {"id": {"type": "string", "minLength": 1}, "projectId": {"type": "string", "minLength": 1}, "graphRevision": {"$ref": "#/$defs/hash"}, "nodeId": {"type": "string", "minLength": 1}, "attemptId": {"type": "string", "minLength": 1}, "roleId": {"type": "string", "minLength": 1}, "key": {"type": "string", "minLength": 1}, "source": {"enum": ["human", "llm", "provider"]}, "outcome": {"type": "string", "minLength": 1}, "facts": {"$ref": "#/$defs/facts"}, "evidenceRefs": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/evidenceRef"}}, "inputDigest": {"$ref": "#/$defs/digest"}, "provider": {"$ref": "#/$defs/provider"}, "createdAt": {"$ref": "#/$defs/timestamp"}, "sequence": {"type": "integer", "minimum": 1}}
    },
    "protectedInput": {"type": "object", "additionalProperties": false, "required": ["name", "digest"], "properties": {"name": {"type": "string", "minLength": 1}, "digest": {"$ref": "#/$defs/digest"}}},
    "observations": {"type": "object", "additionalProperties": false, "required": ["exact", "clean", "depthComplete", "sourceUnmodified", "resourcesClosed"], "properties": {"exact": {"type": "boolean"}, "clean": {"type": "boolean"}, "depthComplete": {"type": "boolean"}, "sourceUnmodified": {"type": "boolean"}, "resourcesClosed": {"type": "boolean"}}},
    "artifact": {"type": "object", "additionalProperties": false, "required": ["digest", "type", "size", "producer"], "properties": {"digest": {"$ref": "#/$defs/digest"}, "type": {"type": "string", "minLength": 1}, "size": {"type": "integer", "minimum": 0}, "producer": {"type": "string", "minLength": 1}, "revision": {"type": "string"}, "invocationDigest": {"$ref": "#/$defs/digest"}}},
    "executionPackage": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "projectId", "graphRevision", "nodeId", "attemptId", "nodeContractDigest", "candidate", "prospectiveTree", "commandGraphDigest", "protectedInputs", "observations", "artifacts", "coreDigest", "createdAt", "sequence"],
      "properties": {"id": {"type": "string", "pattern": "^epkg_[0-9a-f]{64}$"}, "projectId": {"type": "string", "minLength": 1}, "graphRevision": {"$ref": "#/$defs/hash"}, "nodeId": {"type": "string", "minLength": 1}, "attemptId": {"type": "string", "minLength": 1}, "nodeContractDigest": {"$ref": "#/$defs/digest"}, "candidate": {"$ref": "#/$defs/artifact"}, "prospectiveTree": {"$ref": "#/$defs/artifact"}, "commandGraphDigest": {"$ref": "#/$defs/digest"}, "protectedInputs": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"$ref": "#/$defs/protectedInput"}}, "observations": {"$ref": "#/$defs/observations"}, "artifacts": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/artifact"}}, "coreDigest": {"$ref": "#/$defs/digest"}, "createdAt": {"$ref": "#/$defs/timestamp"}, "sequence": {"type": "integer", "minimum": 1}}
    },
    "policy": {"type": "object", "additionalProperties": false, "required": ["id", "version", "schemaHash"], "properties": {"id": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}, "schemaHash": {"$ref": "#/$defs/digest"}}},
    "executionCore": {"type": "object", "additionalProperties": false, "required": ["candidateDigest", "prospectiveTreeDigest", "commandGraphDigest", "nodeContractDigest", "protectedInputs"], "properties": {"candidateDigest": {"$ref": "#/$defs/digest"}, "prospectiveTreeDigest": {"$ref": "#/$defs/digest"}, "commandGraphDigest": {"$ref": "#/$defs/digest"}, "nodeContractDigest": {"$ref": "#/$defs/digest"}, "protectedInputs": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"$ref": "#/$defs/protectedInput"}}}},
    "reuseDecision": {"type": "object", "additionalProperties": false, "required": ["apiVersion", "kind", "id", "packageId", "assessedByAttemptId", "policy", "originalCoreDigest", "currentCore", "currentCoreDigest", "result", "reasons", "createdAt", "sequence"], "properties": {"apiVersion": {"const": "dagrail.io/v1alpha1"}, "kind": {"const": "ReuseDecision"}, "id": {"type": "string", "pattern": "^reuse_[0-9a-f]{64}$"}, "packageId": {"type": "string", "pattern": "^epkg_[0-9a-f]{64}$"}, "assessedByAttemptId": {"type": "string", "minLength": 1}, "policy": {"$ref": "#/$defs/policy"}, "originalCoreDigest": {"$ref": "#/$defs/digest"}, "currentCore": {"$ref": "#/$defs/executionCore"}, "currentCoreDigest": {"$ref": "#/$defs/digest"}, "result": {"enum": ["reuse_execution", "rerun_required"]}, "reasons": {"type": "array", "items": {"type": "string"}}, "createdAt": {"$ref": "#/$defs/timestamp"}, "sequence": {"type": "integer", "minimum": 1}}},
    "action": {"type": "object", "additionalProperties": false, "required": ["id", "kind", "nodeId", "status", "sequence"], "properties": {"id": {"type": "string", "minLength": 1}, "kind": {"enum": ["role.renew", "node.start", "attempt.checkpoint", "attempt.wait", "attempt.resume", "attempt.submit", "task.complete", "review.resolve", "decision.record", "gate.evaluate", "attempt.finish", "effect.prepare", "effect.complete", "resource.close", "resource.reconcile", "evidence.publish", "evidence.assess-reuse"]}, "nodeId": {"type": "string", "minLength": 1}, "attemptId": {"type": "string", "minLength": 1}, "status": {"enum": ["prepared", "confirmed", "failed", "unknown", "reconciling"]}, "sequence": {"type": "integer", "minimum": 1}}, "allOf": [{"if": {"properties": {"kind": {"not": {"const": "role.renew"}}}}, "then": {"required": ["attemptId"]}}]},
    "effect": {"type": "object", "additionalProperties": false, "required": ["id", "nodeId", "attemptId", "adapterId", "status", "sequence"], "properties": {"id": {"type": "string", "minLength": 1}, "nodeId": {"type": "string", "minLength": 1}, "attemptId": {"type": "string", "minLength": 1}, "adapterId": {"type": "string", "minLength": 1}, "adapterVersion": {"type": "string", "minLength": 1}, "adapterSchemaHash": {"type": "string", "minLength": 1}, "ownerRole": {"type": "string"}, "status": {"enum": ["prepared", "dispatched", "confirmed", "failed", "unknown", "reconciling"]}, "receiptDigest": {"$ref": "#/$defs/digest"}, "sequence": {"type": "integer", "minimum": 1}}},
    "resource": {"type": "object", "additionalProperties": false, "required": ["id", "kind", "quantity", "nodeId", "attemptId", "status", "leasedAt"], "properties": {"id": {"type": "string", "minLength": 1}, "kind": {"type": "string", "minLength": 1}, "quantity": {"type": "integer", "minimum": 1}, "nodeId": {"type": "string", "minLength": 1}, "attemptId": {"type": "string", "minLength": 1}, "roleId": {"type": "string"}, "status": {"enum": ["active", "released"]}, "closureStatus": {"enum": ["pending", "confirmed", "failed", "unknown", "reconciling"]}, "closureReceiptDigest": {"$ref": "#/$defs/digest"}, "leasedAt": {"$ref": "#/$defs/timestamp"}, "releasedAt": {"$ref": "#/$defs/timestamp"}}},
    "incidentControl": {"type": "object", "additionalProperties": false, "required": ["authority", "actorRole", "originalOwnerRole", "disposition", "resolution", "note", "appliedAt"], "properties": {"authority": {"const": "incident.control"}, "actorRole": {"type": "string", "minLength": 1}, "originalOwnerRole": {"type": "string", "minLength": 1}, "disposition": {"enum": ["rollback", "lkg", "quarantine", "off-critical-path"]}, "resolution": {"type": "string", "minLength": 1, "maxLength": 1024}, "note": {"type": "string", "minLength": 1, "maxLength": 1024}, "appliedAt": {"$ref": "#/$defs/timestamp"}}},
    "incident": {
      "type": "object", "additionalProperties": false, "required": ["id", "sourceType", "sourceId", "status", "classification", "attemptBudget", "attempts", "openedAt", "updatedAt"],
      "properties": {"id": {"type": "string", "minLength": 1}, "sourceType": {"enum": ["attempt", "effect", "resource"]}, "sourceId": {"type": "string", "minLength": 1}, "nodeId": {"type": "string"}, "ownerRole": {"type": "string"}, "status": {"enum": ["open", "circuit-open", "resolved"]}, "classification": {"enum": ["work-product", "policy", "fixture", "infrastructure", "evidence", "external-effect", "unknown"]}, "deadline": {"$ref": "#/$defs/timestamp"}, "attemptBudget": {"type": "integer", "minimum": 1}, "attempts": {"type": "integer", "minimum": 0}, "noProgressAttempts": {"type": "integer", "minimum": 0}, "progressMetric": {"type": "string"}, "lastProgress": {"type": "string"}, "lastProgressAt": {"$ref": "#/$defs/timestamp"}, "circuitReason": {"type": "string"}, "resolution": {"type": "string"}, "disposition": {"enum": ["retry", "rollback", "lkg", "quarantine", "off-critical-path", "escalate"]}, "dispositionBy": {"type": "string"}, "dispositionAt": {"$ref": "#/$defs/timestamp"}, "dependencyCut": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "remedyNodeId": {"type": "string"}, "supersededAt": {"$ref": "#/$defs/timestamp"}, "control": {"$ref": "#/$defs/incidentControl"}, "openedAt": {"$ref": "#/$defs/timestamp"}, "updatedAt": {"$ref": "#/$defs/timestamp"}}
    },
    "reason": {"type": "object", "additionalProperties": false, "required": ["code"], "properties": {"code": {"type": "string", "minLength": 1}, "edgeId": {"type": "string"}, "sourceNodeId": {"type": "string"}, "predicatePath": {"type": "string"}, "expected": {"type": "string"}, "actual": {"type": "string"}, "resourceKind": {"type": "string"}, "required": {"type": "integer"}, "available": {"type": "integer"}}},
    "explanation": {"type": "object", "additionalProperties": false, "required": ["nodeId", "state"], "properties": {"nodeId": {"type": "string", "minLength": 1}, "state": {"type": "string", "minLength": 1}, "reasons": {"type": "array", "items": {"$ref": "#/$defs/reason"}}}},
    "frontier": {"type": "object", "additionalProperties": false, "required": ["graphRevision", "ready"], "properties": {"graphRevision": {"$ref": "#/$defs/hash"}, "ready": {"type": "array", "items": {"type": "string"}}, "blocked": {"type": "array", "items": {"type": "string"}}, "unreachable": {"type": "array", "items": {"type": "string"}}, "resourceBlocked": {"type": "array", "items": {"type": "string"}}, "dependencyCuts": {"type": "object", "additionalProperties": {"type": "array", "items": {"type": "string"}}}, "explanations": {"type": "array", "items": {"$ref": "#/$defs/explanation"}}}}
  }
}
