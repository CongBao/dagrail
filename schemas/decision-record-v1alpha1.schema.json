{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dagrail.dev/schemas/decision-record-v1alpha1.schema.json",
  "title": "DAGrail DecisionRecord v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "projectId", "graphRevision", "nodeId", "attemptId", "roleId", "key", "source", "outcome", "inputDigest", "createdAt"],
  "properties": {
    "id": {"type": "string", "pattern": "^decision_[a-f0-9]{64}$"},
    "projectId": {"type": "string", "minLength": 1},
    "graphRevision": {"type": "string", "minLength": 1},
    "nodeId": {"type": "string", "minLength": 1},
    "attemptId": {"type": "string", "minLength": 1},
    "roleId": {"type": "string", "minLength": 1},
    "key": {"type": "string", "minLength": 1},
    "source": {"enum": ["human", "llm", "provider"]},
    "outcome": {"type": "string", "minLength": 1},
    "facts": {"$ref": "#/$defs/facts"},
    "evidenceRefs": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/evidenceRef"}},
    "inputDigest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "provider": {"$ref": "#/$defs/provider"},
    "createdAt": {"type": "string", "format": "date-time"},
    "sequence": {"type": "integer", "minimum": 1}
  },
  "allOf": [
    {
      "if": {"properties": {"source": {"const": "provider"}}},
      "then": {"required": ["provider"]},
      "else": {"not": {"required": ["provider"]}}
    }
  ],
  "$defs": {
    "stringMap": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}},
    "facts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "decision": {"$ref": "#/$defs/stringMap"},
        "evidence": {"$ref": "#/$defs/stringMap"},
        "policy": {"$ref": "#/$defs/stringMap"}
      }
    },
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["digest", "type", "size"],
      "properties": {
        "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "type": {"type": "string", "minLength": 1},
        "size": {"type": "integer", "minimum": 0},
        "uri": {"type": "string", "maxLength": 2048}
      }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "schemaHash"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "schemaHash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
      }
    }
  }
}
