{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dagrail.dev/schemas/security-audit-v1alpha1.schema.json",
  "title": "DAGrail security audit v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "secure", "boundary", "checks"],
  "properties": {
    "apiVersion": {"const": "dagrail.io/security/v1alpha1"},
    "kind": {"const": "SecurityAudit"},
    "secure": {"type": "boolean"},
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "isolationBoundary", "permissionsVerified", "multiTenantIsolation", "maliciousPeerProcessIsolation", "permissionEnforcement"],
      "properties": {
        "mode": {"const": "cooperative-single-os-user"},
        "isolationBoundary": {"type": "string", "minLength": 1, "maxLength": 256},
        "permissionsVerified": {"type": "boolean"},
        "multiTenantIsolation": {"const": false},
        "maliciousPeerProcessIsolation": {"const": false},
        "permissionEnforcement": {"type": "string", "minLength": 1, "maxLength": 256}
      }
    },
    "checks": {
      "type": "array",
      "minItems": 10,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "detail"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
          "status": {"enum": ["pass", "warn", "fail"]},
          "detail": {"type": "string", "minLength": 1, "maxLength": 512}
        }
      }
    }
  }
}
