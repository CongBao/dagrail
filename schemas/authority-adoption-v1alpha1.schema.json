{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dagrail.dev/schemas/authority-adoption-v1alpha1.schema.json",
  "title": "DAGrail Authority Adoption Receipt v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "previousProjectId", "previousHead", "sourceBackupDigest", "replacementProjectId", "adoptedAt", "reason", "idempotencyKey", "receiptDigest"],
  "properties": {
    "apiVersion": {"const": "dagrail.io/authority-adoption/v1alpha1"},
    "kind": {"const": "AuthorityAdoptionReceipt"},
    "previousProjectId": {"type": "string", "format": "uuid"},
    "previousHead": {"type": "string", "pattern": "^$|^[0-9a-f]{64}$"},
    "sourceBackupDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "replacementProjectId": {"type": "string", "format": "uuid"},
    "adoptedAt": {"type": "string", "format": "date-time"},
    "reason": {"type": "string", "minLength": 1, "maxLength": 1024},
    "idempotencyKey": {"type": "string", "minLength": 1, "maxLength": 256},
    "receiptDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
